diff --git a/tests/appearance-test.py b/tests/appearance-test.py
new file mode 100644
index 0000000..f4f55e4
--- /dev/null
+++ b/tests/appearance-test.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+import importlib.util
+import os
+from pathlib import Path
+import unittest
+from unittest.mock import Mock, patch
+
+spec = importlib.util.spec_from_file_location(
+    "appearance", Path(__file__).resolve().parents[1] / "piper/appearance.py"
+)
+appearance = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(appearance)
+GLib = appearance.GLib
+
+
+class AppearanceTest(unittest.TestCase):
+    def setUp(self):
+        self.settings = Mock()
+        self.settings.get_property.return_value = False
+        self.proxy = Mock()
+        self.proxy.call_sync.return_value = GLib.Variant("(v)", (GLib.Variant("u", 1),))
+        for item in (
+            patch.object(
+                appearance.Gtk.Settings, "get_default", return_value=self.settings
+            ),
+            patch.object(
+                appearance.Gio.DBusProxy, "new_for_bus_sync", return_value=self.proxy
+            ),
+            patch.dict(os.environ, {}, clear=True),
+        ):
+            item.start()
+            self.addCleanup(item.stop)
+
+    def test_initial_dark_preference(self):
+        appearance.Appearance()
+        self.settings.set_property.assert_called_with(
+            "gtk-application-prefer-dark-theme", True
+        )
+
+    def test_live_light_and_default(self):
+        self.settings.get_property.return_value = True
+        controller = appearance.Appearance()
+        for scheme, expected in ((2, False), (1, True), (0, True)):
+            controller._on_setting_changed(
+                None,
+                None,
+                "SettingChanged",
+                GLib.Variant(
+                    "(ssv)",
+                    (
+                        "org.freedesktop.appearance",
+                        "color-scheme",
+                        GLib.Variant("u", scheme),
+                    ),
+                ),
+            )
+            self.settings.set_property.assert_called_with(
+                "gtk-application-prefer-dark-theme", expected
+            )
+
+    def test_unrelated_signal_and_unknown_scheme(self):
+        controller = appearance.Appearance()
+        self.settings.set_property.reset_mock()
+        controller._apply(99)
+        controller._on_setting_changed(
+            None,
+            None,
+            "SettingChanged",
+            GLib.Variant(
+                "(ssv)", ("another.namespace", "color-scheme", GLib.Variant("u", 2))
+            ),
+        )
+        self.settings.set_property.assert_not_called()
+
+    def test_missing_portal_keeps_gtk_preference(self):
+        self.proxy.call_sync.side_effect = GLib.Error("No portal")
+        appearance.Appearance()
+        self.settings.set_property.assert_not_called()
+
+    def test_explicit_gtk_theme_is_preserved(self):
+        with patch.dict(os.environ, {"GTK_THEME": "Adwaita:light"}):
+            appearance.Appearance()
+        self.proxy.call_sync.assert_not_called()
+        self.settings.set_property.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
