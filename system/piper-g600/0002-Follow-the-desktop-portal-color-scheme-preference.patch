From: James Heinemann <jheinem01@icloud.com>
Date: Sun, 11 Oct 2026 21:17:05 -0700
Subject: [PATCH 2/2] Follow the desktop portal color-scheme preference

Respect KDE dark mode inside Flatpak, react to theme changes, and preserve explicit GTK_THEME overrides and older desktop fallbacks.

Co-Authored-By: Codex <codex@openai.com>
---
 piper/appearance.py      | 56 +++++++++++++++++++++++++
 piper/application.py     |  2 +
 tests/appearance-test.py | 90 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 148 insertions(+)
 create mode 100644 piper/appearance.py
 create mode 100644 tests/appearance-test.py

diff --git a/piper/appearance.py b/piper/appearance.py
new file mode 100644
index 0000000..c73d215
--- /dev/null
+++ b/piper/appearance.py
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+import os
+
+import gi
+
+gi.require_version("Gtk", "3.0")
+from gi.repository import Gio, GLib, Gtk  # noqa
+
+
+class Appearance:
+    """Follow the desktop color scheme, including inside Flatpak on KDE."""
+
+    def __init__(self) -> None:
+        self._settings = Gtk.Settings.get_default()
+        self._proxy = None
+        if self._settings is None or os.environ.get("GTK_THEME"):
+            return
+        self._default_dark = self._settings.get_property(
+            "gtk-application-prefer-dark-theme"
+        )
+        try:
+            self._proxy = Gio.DBusProxy.new_for_bus_sync(
+                Gio.BusType.SESSION,
+                Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES,
+                None,
+                "org.freedesktop.portal.Desktop",
+                "/org/freedesktop/portal/desktop",
+                "org.freedesktop.portal.Settings",
+                None,
+            )
+            self._proxy.connect("g-signal", self._on_setting_changed)
+            result = self._proxy.call_sync(
+                "Read",
+                GLib.Variant("(ss)", ("org.freedesktop.appearance", "color-scheme")),
+                Gio.DBusCallFlags.NONE,
+                1000,
+                None,
+            )
+            self._apply(result.unpack()[0])
+        except GLib.Error:
+            # Older desktops may not provide this portal; keep their GTK setting.
+            pass
+
+    def _apply(self, scheme: int) -> None:
+        if scheme not in (0, 1, 2):
+            return
+        prefer_dark = self._default_dark if scheme == 0 else scheme == 1
+        self._settings.set_property("gtk-application-prefer-dark-theme", prefer_dark)
+
+    def _on_setting_changed(self, proxy, sender, signal, parameters) -> None:
+        if signal != "SettingChanged":
+            return
+        namespace, key, value = parameters.unpack()
+        if namespace == "org.freedesktop.appearance" and key == "color-scheme":
+            self._apply(value)
