#!/usr/bin/bash
set -euo pipefail
# Both stages use the same Bazzite base so Qt/KDE ABI matches the final image.
: "${UPDATER_REF:?Pin a reviewed updater commit}"
CONTROLLABLE_REF=ed318d33f0f243002e019d8e7ee28c3254a2661e
mkdir -p /tmp/updater-source /tmp/controllable-source
curl --fail --location --retry 3 "https://github.com/jheinem1/bazzite-updater-kde/archive/${UPDATER_REF}.tar.gz" | tar xz --strip-components=1 -C /tmp/updater-source
curl --fail --location --retry 3 "https://github.com/rfrench3/controllable/archive/${CONTROLLABLE_REF}.tar.gz" | tar xz --strip-components=1 -C /tmp/controllable-source
cp -a /tmp/controllable-source/. /tmp/updater-source/src/components/controllable/
dnf5 install -y dnf5-plugins gcc-c++ ninja-build git
(cd /tmp/updater-source && dnf5 builddep -y bazzite-updater.spec)
cmake -S /tmp/updater-source -B /tmp/updater-build -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/lib/bazzite-updater-kde \
  -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_QMLDIR=lib/qml \
  -D_INCLUDE_SUBMODULES=ON -D_USE_XDG_CONFIG=ON -DBAZZITE_UPDATER_UI_PROBE=OFF
cmake --build /tmp/updater-build --parallel 2
DESTDIR=/out cmake --install /tmp/updater-build
grep -qx 'BAZZITE_UPDATER_UI_PROBE:BOOL=OFF' /tmp/updater-build/CMakeCache.txt
printf '%s\n' "$UPDATER_REF" > /out/usr/lib/bazzite-updater-kde/source-commit
