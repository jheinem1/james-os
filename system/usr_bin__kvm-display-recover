#!/usr/bin/env python3
"""Report reconnects without overriding KDE display settings."""

import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


def log(message):
    print(f"[kvm-display-recover] {message}", file=sys.stderr, flush=True)


def drm_outputs(root=Path("/sys/class/drm")):
    """Map unique physical display identities to their current connector names."""
    result = {}
    names = set()
    for status in root.glob("card*-*/status"):
        match = re.fullmatch(r"card[0-9]+-(.+)", status.parent.name)
        if not match or match[1].startswith("Writeback-"):
            continue
        try:
            if status.read_text().strip() != "connected":
                continue
            edid = (status.parent / "edid").read_bytes()
        except OSError:
            return None
        name = match[1]
        if len(edid) < 128 or not edid.startswith(b"\x00\xff\xff\xff\xff\xff\xff\x00"):
            return None
        identity = hashlib.sha256(edid).hexdigest()
        if identity in result or name in names:
            return None
        result[identity] = name
        names.add(name)
    return result


def read_state(connectors):
    try:
        raw = subprocess.check_output(["kscreen-doctor", "-j"], timeout=4)
        outputs = json.loads(raw)["outputs"]
        connected = [o for o in outputs if o["connected"] is True]
        by_name = {o["name"]: o for o in connected}
        if len(by_name) != len(connected) or set(by_name) != set(connectors.values()):
            return None
        return {identity: by_name[name] for identity, name in connectors.items()}
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError):
        return None


def report_reconnect(target, topology, settle, attempts):
    for _ in range(attempts):
        time.sleep(settle)
        live = drm_outputs()
        if live is None or live.keys() != topology.keys():
            return
        state = read_state(live)
        if state is not None and state[target].get("enabled") is True:
            log(f"{live[target]} reconnected and is enabled; left unchanged")
            return
    # A configured disabled output and a failed automatic enable are
    # indistinguishable through a delayed KScreen snapshot.
    log(f"{topology[target]} reconnect did not yield a verified enabled output; left unchanged")


def run():
    poll = float(os.getenv("KVM_DISPLAY_POLL_INTERVAL_SECONDS", "0.5"))
    settle = float(os.getenv("KVM_DISPLAY_SETTLE_DELAY_SECONDS", "0.8"))
    attempts = int(os.getenv("KVM_DISPLAY_SETTLE_ATTEMPTS", "12"))
    topology = None
    missing = None
    log("started; desktop display settings are managed by KDE")
    while True:
        connectors = drm_outputs()
        if connectors is None:
            topology = missing = None
        elif topology is not None and connectors.keys() < topology.keys():
            absent = topology.keys() - connectors.keys()
            candidate = next(iter(absent)) if len(absent) == 1 else False
            if missing is None:
                missing = candidate
            elif missing != candidate:
                missing = False
        else:
            if missing and topology is not None and connectors.keys() == topology.keys():
                report_reconnect(missing, connectors, settle, attempts)
            topology = connectors
            missing = None
        time.sleep(poll)


if __name__ == "__main__":
    run()
