#!/usr/bin/env bash
# Subscribe this desktop user to signed Piper releases. No device writes.
set -euo pipefail
umask 077
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
assets="$script_dir/piper-kirigami"
[[ -f "$assets/repository.json" ]] || assets=/usr/share/james-os/piper-kirigami
[[ -f "$assets/repository.json" ]] || { echo 'Piper repository metadata is missing.' >&2; exit 1; }
if [[ "${1:-}" == --version ]]; then
  python3 "$assets/verify-repository.py" "$assets" >/dev/null
  printf 'Piper Kirigami signed update channel: development (latest published release)\n'
  exit 0
fi
if (( $# )); then
  echo 'Usage: james-os-install-piper [--version]' >&2
  exit 2
fi
(( EUID != 0 )) || { echo 'Run as your desktop user, without sudo.' >&2; exit 1; }
[[ $(uname -m) == x86_64 ]] || { echo 'This tested Piper bundle requires x86_64.' >&2; exit 1; }
for command_name in flatpak flock python3 timeout gpg; do
  command -v "$command_name" >/dev/null || { echo "Missing dependency: $command_name" >&2; exit 1; }
done
app=io.github.jheinem1.PiperKirigami
branch=development
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/james-os/piper"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/james-os/piper"
data_root="${XDG_DATA_HOME:-$HOME/.local/share}"
mkdir -p "$state_root" "$cache_root"
exec 9>"$state_root/install.lock"
flock -n 9 || { echo 'Another Piper installation is running.' >&2; exit 1; }
work=$(mktemp -d "$cache_root/download.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
mapfile -t repository < <(python3 "$assets/verify-repository.py" "$assets" "$data_root/flatpak/repo")
[[ ${#repository[@]} == 7 ]] || { echo 'Piper repository is not trusted; nothing installed.' >&2; exit 1; }
remote=${repository[0]}
url=${repository[1]}
# Validate trust before backup/install. Do not silently replace another remote.
if [[ ${repository[6]} == absent ]]; then
  flatpak remote-add --user --gpg-import="$assets/${repository[5]}" "$remote" "$url"
fi
mapfile -t verified < <(python3 "$assets/verify-repository.py" "$assets" "$data_root/flatpak/repo")
[[ ${#verified[@]} == 7 && ${verified[6]} == present ]] || { echo 'Signed Piper remote was not configured.' >&2; exit 1; }
# This refresh verifies the signed summary and ensures the app is available.
flatpak remote-info --user "$remote" "$app/x86_64/$branch" > "$work/remote-info.txt"

# Back up both app identities, launchers and the private GTK saved-profile library.
# Keep GTK installed so rollback does not depend on a runtime download.
backup=$(mktemp -d "$state_root/before-qt-$(date -u +%Y%m%dT%H%M%SZ).XXXXXXXX")
flatpak list --user --app --columns=ref > "$work/installed-refs"
while IFS=/ read -r installed_app arch installed_branch; do
  [[ "$installed_app" == org.freedesktop.Piper || "$installed_app" == "$app" ]] || continue
  flatpak build-bundle --arch="$arch" "$data_root/flatpak/repo" \
    "$backup/$installed_app-$arch-$installed_branch.flatpak" "$installed_app" "$installed_branch"
done < "$work/installed-refs"
for desktop in org.freedesktop.Piper.desktop "$app.desktop"; do
  for location in applications flatpak/exports/share/applications; do
    if [[ -f "$data_root/$location/$desktop" ]]; then
      mkdir -p "$backup/$location"
      cp -L -- "$data_root/$location/$desktop" "$backup/$location/$desktop"
    fi
  done
done
profile_library="$HOME/.var/app/org.freedesktop.Piper/data/piper/profiles"
if [[ -d "$profile_library" ]]; then cp -a -- "$profile_library" "$backup/profile-library"; fi
cp -- "$assets/repository.json" "$backup/repository.json"
cp -- "$work/remote-info.txt" "$backup/remote-info.txt"
printf 'Previous Piper and private profile files saved to %s\n' "$backup"

# Reinstall from the named origin to move a standalone bundle onto normal
# Flatpak updates. No --delete-data: the same app ID retains its private data.
flatpak install --user --noninteractive --reinstall "$remote" "$app/x86_64/$branch"
actual_origin=$(flatpak info --user --show-origin "$app/x86_64/$branch")
[[ "$actual_origin" == "$remote" ]] || { echo 'Installed Piper origin mismatch; launcher was not replaced.' >&2; exit 1; }
flatpak info --user --show-commit "$app/x86_64/$branch" > "$backup/installed-commit.txt"
# A valid bundle can still fail after a shared KDE runtime update. Check the
# actual installed Platform runtime before changing any launcher or taskbar pin.
if ! bash "$assets/verify-runtime.sh" "$backup/runtime-verification"; then
  echo 'Piper runtime compatibility check failed; launchers were not changed. GTK Piper and rollback backups remain available.' >&2
  exit 1
fi
exported="$data_root/flatpak/exports/share/applications/$app.desktop"
[[ -s "$exported" ]] || { echo 'Installed Piper launcher is missing.' >&2; exit 1; }
mkdir -p "$data_root/applications"
# Preserve existing favorites that reference GTK Piper, and hide that duplicate
# from the application menu. The new Qt entry remains the visible launcher.
python3 - "$exported" "$data_root/applications/org.freedesktop.Piper.desktop" <<'PY'
from pathlib import Path
import sys
source, target = map(Path, sys.argv[1:])
lines = source.read_text().splitlines()
lines = [line for line in lines if not line.startswith(('NoDisplay=', 'X-JamesOS-Piper-redirect='))]
index = lines.index('[Desktop Entry]') + 1
lines[index:index] = ['NoDisplay=true', 'X-JamesOS-Piper-redirect=true']
staged = target.with_suffix('.desktop.new')
staged.write_text('\n'.join(lines) + '\n')
staged.replace(target)
PY
if command -v update-desktop-database >/dev/null; then update-desktop-database "$data_root/applications"; fi
if ! python3 "$assets/migrate-plasma-launcher.py" "$backup"; then
  echo 'Piper is installed; repin a direct-file taskbar shortcut to Piper Kirigami if needed.' >&2
fi
printf 'Installed Piper Kirigami from its signed update channel. Close and reopen Piper.\nRollback files: %s\n' "$backup"
printf 'Future releases arrive through normal Flatpak updates.\n'
printf 'Mouse settings and the saved-profile library were not changed. GTK Piper remains installed for rollback.\n'
